# =============================================================================
# Postiz environment — replace placeholders with your real keys
# Copy to .env if needed:  cp .env.example .env
# docker compose loads this file automatically for ${VAR} substitution
# and passes it into the postiz container via env_file.
# =============================================================================

# --- Public URLs ---
MAIN_URL=https://postiz.useautobus.com
FRONTEND_URL=https://postiz.useautobus.com
NEXT_PUBLIC_BACKEND_URL=https://postiz.useautobus.com/api

# --- Core secrets / DB / Redis ---
# JWT_SECRET: any long random string (app auth)
# POSTIZ_POSTGRES_*: credentials for the postiz-postgres container (Compose creates this DB).
# You do NOT get these from Meta/Facebook — generate them yourself (or keep generated values).
# DATABASE_URL must match the three POSTIZ_POSTGRES_* values (host stays postiz-postgres).
JWT_SECRET=replace_with_long_random_jwt_secret
POSTIZ_POSTGRES_USER=postiz
POSTIZ_POSTGRES_PASSWORD=replace_with_strong_db_password
POSTIZ_POSTGRES_DB=postiz
DATABASE_URL=postgresql://postiz:replace_with_strong_db_password@postiz-postgres:5432/postiz
REDIS_URL=redis://postiz-redis:6379
BACKEND_INTERNAL_URL=http://localhost:3000
TEMPORAL_ADDRESS=temporal:7233

IS_GENERAL=true
DISABLE_REGISTRATION=false
RUN_CRON=true

# --- Storage ---
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# --- Facebook Page (required for Digital Marketing → Facebook) ---
# Meta App → Settings → Basic. Redirect URI:
#   https://postiz.useautobus.com/integrations/social/facebook
FACEBOOK_APP_ID=replace_with_facebook_app_id
FACEBOOK_APP_SECRET=replace_with_facebook_app_secret

# --- Instagram ---
# (Postiz uses Facebook app for IG in many setups; fill if your build requires separate keys)

# --- X / Twitter ---
X_API_KEY=replace_with_x_api_key
X_API_SECRET=replace_with_x_api_secret

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=replace_with_linkedin_client_id
LINKEDIN_CLIENT_SECRET=replace_with_linkedin_client_secret

# --- YouTube ---
YOUTUBE_CLIENT_ID=replace_with_youtube_client_id
YOUTUBE_CLIENT_SECRET=replace_with_youtube_client_secret

# --- TikTok ---
# TikTok Developer Portal redirect URI must be:
#   https://postiz.useautobus.com/integrations/social/tiktok
# Products: Login Kit + Content Posting API (enable Direct Post).
# Scopes: user.info.basic, user.info.profile, video.publish, video.upload
# (video.create may appear in older docs; request whatever TikTok still lists.)
# Until TikTok audits the app, Direct Post is SELF_ONLY + capped (~5 users/day).
TIKTOK_CLIENT_ID=replace_with_tiktok_client_id
TIKTOK_CLIENT_SECRET=replace_with_tiktok_client_secret

# --- Other social (optional) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# --- Misc ---
OPENAI_API_KEY=
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POLOTNO=
API_LIMIT=30
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=
NX_ADD_PLUGINS=false
